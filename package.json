{
  "name": "lattis",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "check": "pnpm check:web && pnpm check:rust",
    "check:web": "pnpm --dir ui check",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --exclude netlab --all-targets --locked -- -D warnings",
    "test": "pnpm test:web && pnpm test:rust",
    "test:web": "pnpm --dir ui test",
    "test:rust": "cargo test --workspace --exclude netlab --locked",
    "format": "pnpm --dir ui format && cargo fmt --all",
    "prepare": "prek install"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@j178/prek": "0.5.2"
  }
}
