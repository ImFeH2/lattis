{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattis",
  "version": "0.0.1",
  "identifier": "im.feh2.lattis",
  "build": {
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "pnpm dev"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "pnpm build"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lattis",
        "width": 1120,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
